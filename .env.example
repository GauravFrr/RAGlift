# RAGLift Environment Configuration

# Embedding Provider Configuration
# Options: gemini (default), openai, local
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Vector Store & BM25 Persistence Paths
CHROMA_PATH=./data/chroma
BM25_INDEX_PATH=./data/bm25_index.pkl
INGESTION_LOG_PATH=./data/ingestion_log.jsonl

# Reranker Model (HuggingFace cross-encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Top-K Tuning
TOP_K_RETRIEVE=50
TOP_K_RERANK=5

# Document Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Logging
LOG_LEVEL=INFO
